# =============================================================================
# Painkiller — Configuração de Variáveis de Ambiente (.env)
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Mapeamento de Volume Host (OBRIGATÓRIO para o despachar de tarefas)
# -----------------------------------------------------------------------------
# Como o contêiner API cria contêineres trabalhadores como IRMÃOS via socket Docker do host,
# o caminho do volume ./storage precisa ser o caminho ABSOLUTO no HOST.
#
# Exemplos:
# Linux/macOS: PAINKILLER_HOST_ROOT=/Users/seu_usuario/dev/github/Painkiller/storage
# Windows:     PAINKILLER_HOST_ROOT=D:\dev\github\Painkiller\storage
PAINKILLER_HOST_ROOT=

# -----------------------------------------------------------------------------
# 2. Provedores de LLM e Chaves Globais (Harnesses com Superpowers)
# -----------------------------------------------------------------------------
# Chaves padrão do servidor (utilizadas como fallback quando o projeto não possui
# uma chave de API própria configurada):

# Opção 1: Antigravity CLI (`agy`) + Superpowers (Google Gemini)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Opção 2: DeepSeek Harness (`dsh`) + Superpowers (DeepSeek V4)
DEEPSEEK_API_KEY=

# Configurações do DeepSeek Harness (`dsh --profile acp`). Vazio = padrão do dsh
# (deepseek-v4-flash). Aceita o id ou o nome anunciado, ex.: deepseek-v4-pro.
# PAINKILLER_DEEPSEEK_MODEL=
# PAINKILLER_DEEPSEEK_EFFORT=

# Opção 3: Maki (maki.sh) + Superpowers — usa a mesma DEEPSEEK_API_KEY acima.
# Modelo no formato provider/model-id (padrão: deepseek/deepseek-v4-flash).
# PAINKILLER_MAKI_MODEL=deepseek/deepseek-v4-flash

# Tempo máximo (segundos) de uma execução de tarefa antes de o contêiner ser
# encerrado. Padrão: 1800 (30 min).
# PAINKILLER_TASK_TIMEOUT=1800

# Configurações do Agente Antigravity CLI (`agy`)
PAINKILLER_AGENT_MODEL=gemini-3.8-flash
PAINKILLER_AGENT_EFFORT=medium
PAINKILLER_AGENT_NETWORK=painkiller_default

# -----------------------------------------------------------------------------
# 3. Configurações de Banco de Dados e Imagens Docker
# -----------------------------------------------------------------------------
PAINKILLER_DB_URL=sqlite+aiosqlite:////data/painkiller.db

# Imagens Docker para Antigravity CLI (`agy`)
PAINKILLER_WORKER_IMAGE=painkiller-worker:latest
PAINKILLER_AGENT_IMAGE=painkiller-agent:latest

# Imagens Docker para DeepSeek Harness (`dsh`)
PAINKILLER_WORKER_DEEPSEEK_IMAGE=painkiller-worker-deepseek:latest
PAINKILLER_AGENT_DEEPSEEK_IMAGE=painkiller-agent-deepseek:latest

# Imagens Docker para Maki (`maki`)
PAINKILLER_WORKER_MAKI_IMAGE=painkiller-worker-maki:latest
PAINKILLER_AGENT_MAKI_IMAGE=painkiller-agent-maki:latest

# -----------------------------------------------------------------------------
# 4. Gitea Embutido (Servidor Git)
# -----------------------------------------------------------------------------
PAINKILLER_GITEA_INTERNAL_URL=http://gitea:3000
# Porta do Gitea no host; a EXTERNAL_URL precisa usar a mesma.
PAINKILLER_GITEA_PORT=3300
PAINKILLER_GITEA_EXTERNAL_URL=http://localhost:3300
PAINKILLER_GITEA_USER=painkiller
# Conta de serviço, admin do Gitea inteiro: enxerga os repositórios de todos
# os usuários. Obrigatória e sem padrão — gere uma, por exemplo com
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Trocar o valor é seguro: na subida a API realinha a senha no Gitea.
PAINKILLER_GITEA_PASSWORD=
PAINKILLER_GITEA_EMAIL=bot@painkiller.local

# -----------------------------------------------------------------------------
# 5. Autenticação
# -----------------------------------------------------------------------------
# Admin BREAK-GLASS: acesso de emergência com usuário e senha, para quando o
# login Google estiver fora. Não fica no banco e enxerga TODOS os projetos.
# Senha vazia desabilita esse acesso. Trocar a senha derruba as sessões dele.
PAINKILLER_ADMIN_USER=admin
PAINKILLER_ADMIN_PASSWORD=

# Chave que assina os tokens de sessão (HMAC). Vazia = chave efêmera, e todo
# restart desloga todo mundo. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAINKILLER_AUTH_SECRET=
# Validade do token de sessão, em horas.
PAINKILLER_AUTH_TOKEN_TTL_HOURS=12

# URL pública do Painkiller (a que o navegador usa). Monta o redirect do Google.
PAINKILLER_PUBLIC_URL=http://localhost:8000

# Login com Google (OAuth 2.0). Crie um "OAuth client ID" do tipo "Web
# application" em https://console.cloud.google.com/apis/credentials e cadastre
# os DOIS "Authorized redirect URIs":
#   {PAINKILLER_PUBLIC_URL}/api/auth/google/callback          (Painkiller)
#   {PAINKILLER_GITEA_EXTERNAL_URL}/user/oauth2/google/callback  (Gitea, SSO)
# Vazio desabilita o botão "Entrar com Google".
PAINKILLER_GOOGLE_CLIENT_ID=
PAINKILLER_GOOGLE_CLIENT_SECRET=
# Opcional: sobrescreve o redirect derivado de PAINKILLER_PUBLIC_URL.
# PAINKILLER_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Opcional: só estes domínios de e-mail podem se cadastrar (vírgula separa).
# Vazio = qualquer conta Google com e-mail verificado.
PAINKILLER_GOOGLE_ALLOWED_DOMAINS=

# -----------------------------------------------------------------------------
# 6. Coolify (Provisionamento Automático On-Premise de Teste e Produção)
# -----------------------------------------------------------------------------
# URL da API do Coolify (na rede Docker interna do compose: http://coolify:8000;
# se acessado a partir do host local: http://localhost:8008)
COOLIFY_API_URL=http://coolify:8000
# Token Bearer de API gerado no painel do Coolify (Menu Keys & Tokens / API Tokens)
COOLIFY_API_TOKEN=
# UUID do servidor no Coolify (opcional se houver apenas o servidor local)
COOLIFY_SERVER_UUID=
# Sufixo de domínio wildcard para ambientes de teste e produção
# Exemplo: 127.0.0.1.nip.io (resolve automaticamente para 127.0.0.1 sem DNS local)
COOLIFY_WILDCARD_DOMAIN=127.0.0.1.nip.io
# URL do Gitea acessível pelo Coolify para clonagem de repositórios
COOLIFY_GITEA_URL=http://painkiller-gitea:3000
# Porta pública de acesso ao painel do Coolify no host
COOLIFY_PORT=8008
