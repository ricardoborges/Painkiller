# =============================================================================
# Painkiller — variaveis de ambiente
#
# Copie para .env. O servidor carrega este arquivo com override=True na
# importacao, entao mudancas exigem reiniciar o uvicorn / o container da api.
# =============================================================================

# ---- Analise inicial (Antigravity CLI + superpowers + Gemini) --------------
# Obrigatoria para "Iniciar analise". Alternativa: GOOGLE_API_KEY.
GEMINI_API_KEY=
PAINKILLER_AGENT_MODEL=gemini-3.8-flash
PAINKILLER_AGENT_EFFORT=medium

# ---- Agente de codificacao (Aider, one-shot por tarefa) ---------------------
# Qualquer endpoint compativel com OpenAI. Chave nvapi- sem base usa a NVIDIA
# Build automaticamente; modelos sem prefixo de provedor recebem "openai/".
PAINKILLER_LLM_MODEL=moonshotai/kimi-k3
PAINKILLER_LLM_API_BASE=
PAINKILLER_LLM_API_KEY=
# ou, equivalentes: NVIDIA_API_KEY= / OPENAI_API_KEY= / OPENAI_API_BASE=

# ---- Publicacao em producao (Coolify) --------------------------------------
# Token em Coolify > Keys & Tokens > API tokens. Os UUIDs aparecem na URL do
# projeto e do servidor na interface do Coolify. Sem estas quatro variaveis o
# botao "Publicar" e o passo final do piloto automatico ficam desativados.
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT_NAME=production
# Opcional: dominio por projeto, ex. https://{slug}.apps.exemplo.com.br
COOLIFY_DOMAIN_TEMPLATE=
# Opcional: como o servidor do Coolify enxerga o Gitea embutido, quando nao e
# o mesmo endereco que o navegador usa (ex.: http://192.168.0.10:3000).
COOLIFY_GIT_BASE_URL=

# ---- Gitea embutido (docker compose) ---------------------------------------
PAINKILLER_GITEA_EXTERNAL_URL=http://localhost:3000
PAINKILLER_GITEA_USER=painkiller
PAINKILLER_GITEA_PASSWORD=troque-esta-senha
PAINKILLER_GITEA_EMAIL=bot@painkiller.local

# ---- Topologia de containers (docker compose) -------------------------------
# Caminho ABSOLUTO no host da pasta ./storage; ver comentario no compose.
#   Windows      D:\dev\github\Painkiller\storage
#   Linux/macOS  /home/voce/painkiller/storage
PAINKILLER_HOST_ROOT=
