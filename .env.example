# =============================================================================
# Painkiller — Configuração de Variáveis de Ambiente (.env)
# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
#
# Aqui ficam só ajustes de infraestrutura. O administrador é criado no
# primeiro acesso pelo navegador; URL pública, pasta de projetos no host, login
# Google e Coolify são configurados no wizard de setup (e depois em Admin →
# Configurações). Tudo isso, e a chave que assina as sessões, fica no banco.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Harnesses (modelos e limites)
# -----------------------------------------------------------------------------
# Não há chave de LLM global: cada projeto cadastra a própria chave (Gemini ou
# DeepSeek, conforme o harness) ao ser criado, e paga o próprio consumo.

# DeepSeek Harness (`dsh`). Vazio = padrão do dsh (deepseek-v4-flash).
# PAINKILLER_DEEPSEEK_MODEL=
# PAINKILLER_DEEPSEEK_EFFORT=

# Maki (maki.sh). Modelo no formato provider/model-id.
# PAINKILLER_MAKI_MODEL=deepseek/deepseek-v4-flash

# Tempo máximo (segundos) de uma execução de tarefa antes de o contêiner ser
# encerrado. Padrão: 1800 (30 min).
# PAINKILLER_TASK_TIMEOUT=1800

# Antigravity CLI (`agy`)
PAINKILLER_AGENT_MODEL=gemini-3.8-flash
PAINKILLER_AGENT_EFFORT=medium
PAINKILLER_AGENT_NETWORK=painkiller_default

# -----------------------------------------------------------------------------
# 2. Configurações de Banco de Dados e Imagens Docker
# -----------------------------------------------------------------------------
PAINKILLER_DB_URL=sqlite+aiosqlite:////data/painkiller.db

# Imagens Docker para Antigravity CLI (`agy`)
PAINKILLER_WORKER_IMAGE=painkiller-worker:latest
PAINKILLER_AGENT_IMAGE=painkiller-agent:latest

# Imagens Docker para DeepSeek Harness (`dsh`)
PAINKILLER_WORKER_DEEPSEEK_IMAGE=painkiller-worker-deepseek:latest
PAINKILLER_AGENT_DEEPSEEK_IMAGE=painkiller-agent-deepseek:latest

# Imagens Docker para Maki (`maki`)
PAINKILLER_WORKER_MAKI_IMAGE=painkiller-worker-maki:latest
PAINKILLER_AGENT_MAKI_IMAGE=painkiller-agent-maki:latest

# -----------------------------------------------------------------------------
# 3. Gitea Embutido (Servidor Git)
# -----------------------------------------------------------------------------
PAINKILLER_GITEA_INTERNAL_URL=http://gitea:3000
# Porta do Gitea no host (para clone SSH/HTTP direto ou inspeção avulsa)
PAINKILLER_GITEA_PORT=3300
# URL acessada pelo navegador (com proxy e SSO embutidos no Painkiller: http://localhost:8000/gitea/)
PAINKILLER_GITEA_EXTERNAL_URL=http://localhost:8000/gitea/
PAINKILLER_GITEA_USER=painkiller
# Conta de serviço, admin do Gitea inteiro: enxerga os repositórios de todos
# os usuários. Obrigatória e sem padrão — gere uma, por exemplo com
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Trocar o valor é seguro: na subida a API realinha a senha no Gitea.
PAINKILLER_GITEA_PASSWORD=
PAINKILLER_GITEA_EMAIL=bot@painkiller.local

# -----------------------------------------------------------------------------
# 4. Sessões
# -----------------------------------------------------------------------------
# Validade do token de sessão, em horas. Esqueceu a senha do administrador?
#   docker compose exec api painkiller admin-reset && docker compose restart api
PAINKILLER_AUTH_TOKEN_TTL_HOURS=12

# -----------------------------------------------------------------------------
# 5. Coolify (ambientes de teste e produção)
# -----------------------------------------------------------------------------
# Token, servidor e domínio dos ambientes são configurados pelo wizard. Estes
# são fixos pelo compose; mude só se rodar o Coolify em outro lugar.
COOLIFY_API_URL=http://coolify:8080
COOLIFY_GITEA_URL=http://painkiller-gitea:3000
# Porta pública do painel do Coolify no host (o wizard monta os links com ela).
COOLIFY_PORT=8008
