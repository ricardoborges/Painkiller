# Variáveis do backend. Os valores reais nunca entram no repositório: em teste
# e produção eles chegam como variáveis de ambiente do deploy.
#
# Origens que podem chamar a API, separadas por vírgula ("*" libera todas).
CORS_ORIGINS=*
# Requisições por minuto por IP nas rotas da API (0 desliga o limite).
RATE_LIMIT_PER_MINUTE=60
