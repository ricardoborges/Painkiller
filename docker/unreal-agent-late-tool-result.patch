+func TestRequestBodySendsLateToolResultAsUserMessage(t *testing.T) {
+	body, err := requestBody(llm.Request{
+		Model: llm.Model{ID: "gpt-test"},
+		Input: []llm.Item{
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "call-1", Name: "Bash", Arguments: "{}"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "call-1", Output: []llm.ToolResultOutput{{Kind: llm.ToolResultText, Value: "still running"}}}},
+			{Type: llm.ItemMessage, Data: llm.Message{Role: llm.RoleUser, Text: "Heartbeat"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "call-1", Output: []llm.ToolResultOutput{
+				{Kind: llm.ToolResultText, Value: "done"},
+				{Kind: llm.ToolResultImage, Value: "https://example.com/image.png"},
+			}}},
+		},
+	}, "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var request struct {
+		Input []map[string]any `json:"input"`
+	}
+	if err := json.Unmarshal(body, &request); err != nil {
+		t.Fatal(err)
+	}
+	outputs := 0
+	for _, item := range request.Input {
+		if item["type"] == "function_call_output" {
+			outputs++
+		}
+	}
+	if outputs != 1 {
+		t.Fatalf("function_call_output items = %d, want 1: %s", outputs, body)
+	}
+	var want map[string]any
+	if err := json.Unmarshal([]byte(`{"type":"message","role":"user","content":[
+		{"type":"input_text","text":"Result of tool call call-1, which was still running earlier:"},
+		{"type":"input_text","text":"done"},
+		{"type":"input_image","detail":"auto","image_url":"https://example.com/image.png"}]}`), &want); err != nil {
+		t.Fatal(err)
+	}
+	if got := request.Input[len(request.Input)-1]; !reflect.DeepEqual(got, want) {
+		t.Fatalf("late result = %#v, want %#v", got, want)
+	}
+}
