+// pairToolResults moves the first result of each call right after the run of
+// calls it answers.
+//
+// The history can put other items between a call and its first result: a
+// heartbeat or an external input staged before the result, or a late result
+// sent as a user message (see lateToolResultMessage). Providers that turn
+// Responses input into chat messages (DeepSeek answers "No tool output found
+// for tool call") require every call to be followed by its output, with
+// nothing in between. Moved items keep their relative order after the
+// results. Nothing is invented: a call with no result stays as it is.
+func pairToolResults(items []llm.Item) []llm.Item {
+	first := make(map[string]int)
+	for index, item := range items {
+		if result, ok := item.Data.(llm.ToolResult); ok && item.Type == llm.ItemToolResult {
+			if _, seen := first[result.CallID]; !seen {
+				first[result.CallID] = index
+			}
+		}
+	}
+	moved := make([]bool, len(items))
+	paired := make([]llm.Item, 0, len(items))
+	for index := 0; index < len(items); index++ {
+		if moved[index] {
+			continue
+		}
+		if items[index].Type != llm.ItemToolCall {
+			paired = append(paired, items[index])
+			continue
+		}
+		end := index
+		for end < len(items) && items[end].Type == llm.ItemToolCall {
+			paired = append(paired, items[end])
+			end++
+		}
+		for _, item := range items[index:end] {
+			call, ok := item.Data.(llm.ToolCall)
+			if !ok {
+				continue
+			}
+			if position, found := first[call.CallID]; found && position >= end {
+				paired = append(paired, items[position])
+				moved[position] = true
+			}
+		}
+		index = end - 1
+	}
+	return paired
+}
+
+// lateToolResultMessage encodes a repeated result for an already answered call.
+//
+// A call that is still running when its turn ends is answered with a
+// placeholder, and its final result arrives in a later turn as a second result
+// for the same call. The committed history is never rewritten, so the
+// placeholder stays. Providers that require one output per call_id (DeepSeek
+// answers "Duplicate tool output for call_id") reject a second
+// function_call_output, so the final result is sent as a user message instead.
+func lateToolResultMessage(result llm.ToolResult) (openaiapi.InputItem, error) {
+	var item openaiapi.InputItem
+	contents := make([]openaiapi.InputContent, 0, len(result.Output)+1)
+	header := "Result of tool call " + result.CallID + ", which was still running earlier:"
+	parts := []llm.ToolResultOutput{{Kind: llm.ToolResultText, Value: header}}
+	for _, part := range append(parts, result.Output...) {
+		var content any
+		switch part.Kind {
+		case llm.ToolResultText:
+			content = openaiapi.InputTextContent{
+				Text: part.Value,
+				Type: openaiapi.InputTextContentTypeInputText,
+			}
+		case llm.ToolResultImage:
+			content = openaiapi.InputImageContent{
+				Detail:   openaiapi.ImageDetailAuto,
+				ImageUrl: &part.Value,
+				Type:     openaiapi.InputImageContentTypeInputImage,
+			}
+		default:
+			return item, fmt.Errorf("unsupported tool result kind %q", part.Kind)
+		}
+		var converted openaiapi.InputContent
+		if err := setUnion(&converted, content); err != nil {
+			return item, err
+		}
+		contents = append(contents, converted)
+	}
+	messageType := openaiapi.InputMessageTypeMessage
+	message := openaiapi.InputMessage{
+		Content: contents,
+		Role:    openaiapi.InputMessageRoleUser,
+		Type:    &messageType,
+	}
+	var converted openaiapi.Item
+	if err := setUnion(&converted, message); err != nil {
+		return item, err
+	}
+	if err := setUnion(&item, converted); err != nil {
+		return item, err
+	}
+	return item, nil
+}
