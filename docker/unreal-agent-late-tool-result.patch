+func TestRequestBodySendsLateToolResultAsUserMessage(t *testing.T) {
+	body, err := requestBody(llm.Request{
+		Model: llm.Model{ID: "gpt-test"},
+		Input: []llm.Item{
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "call-1", Name: "Bash", Arguments: "{}"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "call-1", Output: []llm.ToolResultOutput{{Kind: llm.ToolResultText, Value: "still running"}}}},
+			{Type: llm.ItemMessage, Data: llm.Message{Role: llm.RoleUser, Text: "Heartbeat"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "call-1", Output: []llm.ToolResultOutput{
+				{Kind: llm.ToolResultText, Value: "done"},
+				{Kind: llm.ToolResultImage, Value: "https://example.com/image.png"},
+			}}},
+		},
+	}, "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var request struct {
+		Input []map[string]any `json:"input"`
+	}
+	if err := json.Unmarshal(body, &request); err != nil {
+		t.Fatal(err)
+	}
+	outputs := 0
+	for _, item := range request.Input {
+		if item["type"] == "function_call_output" {
+			outputs++
+		}
+	}
+	if outputs != 1 {
+		t.Fatalf("function_call_output items = %d, want 1: %s", outputs, body)
+	}
+	var want map[string]any
+	if err := json.Unmarshal([]byte(`{"type":"message","role":"user","content":[
+		{"type":"input_text","text":"Result of tool call call-1, which was still running earlier:"},
+		{"type":"input_text","text":"done"},
+		{"type":"input_image","detail":"auto","image_url":"https://example.com/image.png"}]}`), &want); err != nil {
+		t.Fatal(err)
+	}
+	if got := request.Input[len(request.Input)-1]; !reflect.DeepEqual(got, want) {
+		t.Fatalf("late result = %#v, want %#v", got, want)
+	}
+}
+
+func TestRequestBodyPairsEveryCallWithItsResult(t *testing.T) {
+	text := func(value string) []llm.ToolResultOutput {
+		return []llm.ToolResultOutput{{Kind: llm.ToolResultText, Value: value}}
+	}
+	body, err := requestBody(llm.Request{
+		Model: llm.Model{ID: "gpt-test"},
+		Input: []llm.Item{
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "a", Name: "Bash", Arguments: "{}"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "a", Output: text("still running")}},
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "b", Name: "Bash", Arguments: "{}"}},
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "c", Name: "Bash", Arguments: "{}"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "b", Output: text("done b")}},
+			// O resultado tardio de "a" vira mensagem do usuário: não pode separar "c" do seu resultado.
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "a", Output: text("done a")}},
+			{Type: llm.ItemMessage, Data: llm.Message{Role: llm.RoleUser, Text: "Heartbeat"}},
+			{Type: llm.ItemToolResult, Data: llm.ToolResult{CallID: "c", Output: text("done c")}},
+			// Ainda sem resultado: nada é inventado.
+			{Type: llm.ItemToolCall, Data: llm.ToolCall{CallID: "d", Name: "Bash", Arguments: "{}"}},
+		},
+	}, "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var request struct {
+		Input []map[string]any `json:"input"`
+	}
+	if err := json.Unmarshal(body, &request); err != nil {
+		t.Fatal(err)
+	}
+	var got []string
+	for _, item := range request.Input {
+		switch item["type"] {
+		case "function_call":
+			got = append(got, "call "+item["call_id"].(string))
+		case "function_call_output":
+			output := item["output"].([]any)[0].(map[string]any)["text"].(string)
+			got = append(got, "output "+item["call_id"].(string)+": "+output)
+		case "message", nil:
+			if item["role"] != "user" {
+				continue
+			}
+			switch content := item["content"].(type) {
+			case string:
+				got = append(got, "user: "+content)
+			case []any:
+				got = append(got, "user: "+content[len(content)-1].(map[string]any)["text"].(string))
+			}
+		}
+	}
+	want := []string{
+		"call a", "output a: still running",
+		"call b", "call c", "output b: done b", "output c: done c",
+		"user: done a", "user: Heartbeat",
+		"call d",
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("input order = %q, want %q", got, want)
+	}
+}
